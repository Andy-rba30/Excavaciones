<Window x:Class="Excavaciones.UI.ResultadosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excavaciones - Metrado" Width="680" Height="520" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Header" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <DataGrid x:Name="ResultGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F4F4F4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="*"/>
                <DataGridTextColumn Header="Und." Binding="{Binding Unidad}" Width="60"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadTexto}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
        <Expander x:Name="WarningsExpander" Grid.Row="2" Header="Avisos" Margin="0,8,0,0" IsExpanded="False">
            <TextBox x:Name="Warnings" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Foreground="#A05000"/>
        </Expander>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Exportar CSV…" Width="120" Margin="4" Padding="4" Click="Csv_Click"/>
            <Button x:Name="OkButton" Content="Crear sólidos en el modelo" Width="190" Margin="4" Padding="4" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cerrar sin crear" Width="130" Margin="4" Padding="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
