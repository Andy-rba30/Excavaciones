<Window x:Class="Excavaciones.UI.PlataformaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excavación de plataforma (corte y relleno con taludes)" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="2"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <GroupBox Header="Terreno natural">
            <StackPanel>
                <ComboBox x:Name="TerrainCombo"/>
                <TextBlock x:Name="TerrainInfo" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Cota de plataforma (fondo de corte / rasante de relleno)">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <RadioButton x:Name="ByLevel" Content="Nivel" IsChecked="True" Margin="4" VerticalAlignment="Center"/>
                <ComboBox x:Name="LevelCombo" Grid.Column="1"/>
                <TextBlock Grid.Column="2" Text="Desfase (m)"/>
                <TextBox x:Name="LevelOffset" Grid.Column="3" Text="0.00"/>
                <RadioButton x:Name="ByElevation" Grid.Row="1" Content="Cota (m)" Margin="4" VerticalAlignment="Center"/>
                <ComboBox x:Name="ReferenceCombo" Grid.Row="1" Grid.Column="1"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Valor (m)"/>
                <TextBox x:Name="Elevation" Grid.Row="1" Grid.Column="3" Text="0.00"/>
                <TextBlock x:Name="ElevationHint" Grid.Row="2" Grid.ColumnSpan="4" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Taludes">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Talud de corte (H : 1V)"/>
                <TextBox x:Name="CutRatio" Grid.Column="1" Text="1.00"/>
                <TextBlock Grid.Column="2" Text="Talud de relleno (H : 1V)"/>
                <TextBox x:Name="FillRatio" Grid.Column="3" Text="1.50"/>
                <TextBlock Grid.Row="1" Text="Bermas en corte: altura entre bermas (m)"/>
                <TextBox x:Name="BermHeight" Grid.Row="1" Grid.Column="1" Text="0.00"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Ancho de berma (m)"/>
                <TextBox x:Name="BermWidth" Grid.Row="1" Grid.Column="3" Text="1.00"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Foreground="Gray" FontSize="11" Text="Talud 0 = pared vertical. Altura entre bermas 0 = sin bermas."/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Metrado y resultados">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Factor de esponjamiento"/>
                <TextBox x:Name="Swell" Grid.Column="1" Text="1.25"/>
                <TextBlock Grid.Column="2" Text="Nombre del grupo"/>
                <TextBox x:Name="GroupName" Grid.Column="3" Text="Plataforma 1"/>
                <CheckBox x:Name="CreateSolids" Grid.Row="1" Grid.ColumnSpan="4" IsChecked="True" Content="Crear sólidos de corte y relleno (Modelos genéricos con parámetros EXC_* para tablas)"/>
            </Grid>
        </GroupBox>
        <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Al aceptar se pedirá seleccionar el contorno de la plataforma: líneas de modelo/detalle cerradas, región rellena, suelo, área o habitación."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="Ok" Content="Aceptar y seleccionar contorno" Width="200" Margin="4" Padding="4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Width="90" Margin="4" Padding="4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
