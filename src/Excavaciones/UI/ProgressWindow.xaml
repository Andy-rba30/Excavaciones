<Window x:Class="Excavaciones.UI.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excavaciones - Calculando" Width="420" Height="140" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Message" Text="Preparando..." Margin="0,0,0,8"/>
        <ProgressBar x:Name="Bar" Grid.Row="1" Height="18" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="Detail" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray" FontSize="11"/>
    </Grid>
</Window>
