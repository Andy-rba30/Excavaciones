<Window x:Class="Excavaciones.UI.CimentacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excavación por cimentación (con taludes y metrado)" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="2"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <GroupBox Header="Terreno natural">
            <StackPanel>
                <ComboBox x:Name="TerrainCombo"/>
                <TextBlock x:Name="TerrainInfo" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Geometría de la excavación">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Sobreexcavación lateral (m)" ToolTip="Espacio de trabajo alrededor de la cimentación"/>
                <TextBox x:Name="Lateral" Grid.Column="1" Text="0.50"/>
                <TextBlock Grid.Column="2" Text="Profundidad adicional bajo fondo (m)" ToolTip="Solado, mejoramiento, etc."/>
                <TextBox x:Name="ExtraDepth" Grid.Column="3" Text="0.10"/>
                <TextBlock Grid.Row="1" Text="Talud (H : 1V)"/>
                <TextBox x:Name="Ratio" Grid.Row="1" Grid.Column="1" Text="0.50"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Altura entre bermas (m)"/>
                <TextBox x:Name="BermHeight" Grid.Row="1" Grid.Column="3" Text="0.00"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Ancho de berma (m)"/>
                <TextBox x:Name="BermWidth" Grid.Row="2" Grid.Column="3" Text="1.00"/>
                <CheckBox x:Name="Merge" Grid.Row="2" Grid.ColumnSpan="2" IsChecked="True" Content="Unir excavaciones adyacentes (evita doble conteo)"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Metrado y resultados">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Factor de esponjamiento"/>
                <TextBox x:Name="Swell" Grid.Column="1" Text="1.25"/>
                <TextBlock Grid.Column="2" Text="Nombre del grupo"/>
                <TextBox x:Name="GroupName" Grid.Column="3" Text="Cimentación"/>
                <CheckBox x:Name="Subtract" Grid.Row="1" Grid.ColumnSpan="4" IsChecked="True" Content="Descontar el volumen enterrado de la cimentación para el relleno con material propio"/>
                <CheckBox x:Name="CreateSolids" Grid.Row="2" Grid.ColumnSpan="4" IsChecked="True" Content="Crear sólidos de excavación (Modelos genéricos con parámetros EXC_* para tablas)"/>
                <CheckBox x:Name="Excavate" Grid.Row="3" Grid.ColumnSpan="4" IsChecked="False" Content="Intentar aplicar la excavación al Toposolid con Toposolid.ExcavateBy (experimental)"/>
            </Grid>
        </GroupBox>
        <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Al aceptar se pedirá seleccionar las cimentaciones (zapatas, losas, vigas de cimentación, muros, columnas, modelos genéricos, tuberías). La huella se toma de sus caras inferiores."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Aceptar y seleccionar cimentaciones" Width="220" Margin="4" Padding="4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Width="90" Margin="4" Padding="4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
